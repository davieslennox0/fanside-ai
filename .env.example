# Hosting domain — read from env, never hardcoded, so the real domain can
# be dropped in later without touching code.
DOMAIN_NAME=fanside.example.com
PORT=4050

# --- The Graph Subgraph MCP (the load-bearing piece for this track) ---
# Get a Gateway API key: thegraph.com/studio -> connect wallet -> API Keys
# -> Create API Key. Fresh, dedicated key for this project only.
GRAPH_GATEWAY_API_KEY=
GRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse

# --- Groq (query generation + answer synthesis) ---
# Reuses the same Groq key as hedera-x402 (Groq isn't the judged
# differentiator here, The Graph is — unlike the Gateway key/wallet, which
# stay fresh and dedicated to this project).
GROQ_API_KEY=
# openai/gpt-oss-20b: smaller/faster than the openai/gpt-oss-120b model used
# elsewhere, for higher effective throughput since every paid query makes 2
# Groq calls. llama-3.1 was requested but isn't in this key's model catalog
# (GET /v1/models) — check your own key's catalog before assuming otherwise.
GROQ_MODEL=openai/gpt-oss-20b

# --- Payment rail: self-hosted x402 facilitator, EVM on Base ---
# No external facilitator (e.g. Blocky402) — this process verifies the
# buyer's EIP-3009/Permit2 signature and broadcasts settlement itself with
# its own funded relayer key, using @x402/evm's ExactEvmScheme facilitator.
# Fresh deployer/relayer wallet, dedicated to this project only — do NOT
# reuse Pitchook's X Layer wallet or any other project's key.
#
# Base Sepolia testnet (chain 84532) by default — free faucet ETH, no real
# funds at risk for a hackathon demo. Set BASE_CHAIN_ID=8453 + BASE_RPC_URL
# to a mainnet RPC + USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# to run on Base mainnet instead.
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Seller/relayer — receives payment (payTo) and pays gas to settle it.
# Generate with: node -e "console.log(require('viem/accounts').generateAccount ? '' : ''); "
# or the project's own scripts/generate-wallet.mjs (see README).
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=

# Buyer — only needed for the demo/test client that pays the agent itself.
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=
